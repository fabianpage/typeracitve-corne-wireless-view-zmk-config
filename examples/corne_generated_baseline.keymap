    };

    macros {
        // BEGIN macros
        esc_layerreset: esc_layerreset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE &to 0>;
        };

        daechli: daechli {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_CARET &kp SPACE>;
        };

        tilde: tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(DE_N) &kp SPACE>;
        };

        M_UPPER_AEOEUE: AE {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&kp CAPSLOCK>,
                <&macro_pause_for_release>,
                <&macro_param_1to1>,
                <&kp MACRO_PLACEHOLDER>,
                <&kp CAPSLOCK>;
            wait-ms = <80>;
            tap-ms = <80>;
        };

        M_UE: M_UE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CAPSLOCK &kp DE_U_UMLAUT &kp CAPSLOCK>;
            wait-ms = <20>;
            tap-ms = <20>;
        };

        M_OE: M_OE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CAPSLOCK &kp DE_O_UMLAUT &kp CAPSLOCK>;
            wait-ms = <100>;
            tap-ms = <100>;
        };

        backtick_macro: backtick_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_GRAVE &kp SPACE>;
        };

        fronttick_macro: fronttick_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(EQUAL) &kp SPACE>;
        };

        ue1: ue1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT &kp DE_N1>;
        };

        ue2: ue2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT &kp DE_N2>;
        };

        ue3: ue3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT &kp DE_N3>;
        };

        ue4: ue4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT &kp DE_N4>;
        };

        ue5: ue5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT &kp DE_N5>;
        };

        ue6: ue6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT &kp DE_N6>;
        };

        ue7: ue7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT &kp DE_N7>;
        };

        ue8: ue8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT &kp DE_N8>;
        };

        ue9: ue9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT &kp DE_N9>;
        };

        ue0: ue0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT &kp DE_N0>;
        };

        tmux_next_window: tmux_next_window {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT &kp DE_N>;
        };

        tmux_prev_window: tmux_prev_window {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT &kp DE_P>;
        };
        // END macros
    };

    behaviors {
        // BEGIN behaviors
        lh_ht: lh_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35>;
            flavor = "balanced";
            hold-trigger-on-release;
            quick-tap-ms = <150>;
            global-quick-tap;
            tapping-term-ms = <200>;
        };

        rh_ht: rh_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29>;
            flavor = "balanced";
            hold-trigger-on-release;
            quick-tap-ms = <150>;
            global-quick-tap;
            tapping-term-ms = <200>;
        };

        square_brackets: square_brackets {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LA(DE_N5)>, <&kp LA(DE_N6)>;
            mods = <(MOD_LSFT)>;
        };

        round_brackets: round_brackets {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(DE_N8)>, <&kp LS(DE_N9)>;
            mods = <(MOD_LSFT)>;
        };

        angled_brackets: angled_brackets {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_LESS_THAN>, <&kp DE_GREATER_THAN>;
            mods = <(MOD_LSFT)>;
        };

        curly_brackets: curly_brackets {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LA(DE_N8)>, <&kp LA(DE_N9)>;
            mods = <(MOD_LSFT)>;
        };

        backspace_delete: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;
            mods = <(MOD_LSFT)>;
        };

        double_single_quote: double_single_quote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_DOUBLE_QUOTES>, <&kp MINUS>;
            mods = <(MOD_LSFT)>;
        };

        back_front_tick: back_front_tick {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&backtick_macro>, <&fronttick_macro>;
            mods = <(MOD_LSFT)>;
        };

        punkt_doppelpunkt: punkt_doppelpunkt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_DOT>, <&kp DE_COLON>;
            mods = <(MOD_LSFT)>;
        };

        komma_strickpunkt: komma_strickpunkt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_COMMA>, <&kp DE_SEMICOLON>;
            mods = <(MOD_LSFT)>;
        };

        frage_ausrufe_zeichen: frage_ausrufe_zeichen {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_QUESTION>, <&kp DE_EXCLAMATION>;
            mods = <(MOD_LSFT)>;
        };

        daechli_tilde: daechli_tilde {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&daechli>, <&tilde>;
            mods = <(MOD_LSFT)>;
        };

        prozent_ringli: prozent_ringli {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_PERCENT>, <&kp LS(NON_US_BSLH)>;
            mods = <(MOD_LSFT)>;
        };

        hash_pipe: hash_pipe {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_HASH>, <&kp DE_PIPE>;
            mods = <(MOD_LSFT)>;
        };

        at_equal: at_equal {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LA(DE_G)>, <&kp DE_EQUAL>;
            mods = <(MOD_LSFT)>;
        };

        dollar_ampersand: dollar_ampersand {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_DOLLAR>, <&kp DE_AMPERSAND>;
            mods = <(MOD_LSFT)>;
        };

        slash_backslash: slash_backslash {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_SLASH>, <&kp LS(LA(DE_N7))>;
            mods = <(MOD_LSFT)>;
        };

        mal_plus: mal_plus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_ASTERISK>, <&kp DE_PLUS>;
            mods = <(MOD_LSFT)>;
        };

        minus_underscore: minus_underscore {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_MINUS>, <&kp DE_UNDER>;
            mods = <(MOD_LSFT)>;
        };

        B_AE: B_AE {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_A_UMLAUT>, <&M_UPPER_AEOEUE DE_A_UMLAUT>;
            mods = <(MOD_LSFT)>;
        };

        B_UE: B_UE {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT>, <&M_UE>;
            mods = <(MOD_LSFT)>;
        };

        B_OE: B_OE {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_O_UMLAUT>, <&M_OE>;
            mods = <(MOD_LSFT)>;
        };

        hCh: hCh {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_H>, <&kp LC(DE_H)>;
            mods = <(MOD_LSFT)>;
        };

        jCj: jCj {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_J>, <&kp LC(DE_J)>;
            mods = <(MOD_LSFT)>;
        };

        kCk: kCk {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_K>, <&kp LC(DE_K)>;
            mods = <(MOD_LSFT)>;
        };

        lCl: lCl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_L>, <&kp LC(DE_L)>;
            mods = <(MOD_LSFT)>;
        };

        n0ue0: n0ue0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N0>, <&ue0>;
            mods = <(MOD_LSFT)>;
        };

        n1ue1: n1ue1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N1>, <&ue1>;
            mods = <(MOD_LSFT)>;
        };

        n2ue2: n2ue2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N2>, <&ue2>;
            mods = <(MOD_LSFT)>;
        };

        n3ue3: n3ue3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N3>, <&ue3>;
            mods = <(MOD_LSFT)>;
        };

        n4ue4: n4ue4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N4>, <&ue4>;
            mods = <(MOD_LSFT)>;
        };

        n5ue5: n5ue5 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N5>, <&ue5>;
            mods = <(MOD_LSFT)>;
        };

        n6ue6: n6ue6 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N6>, <&ue6>;
            mods = <(MOD_LSFT)>;
        };

        n7ue7: n7ue7 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N7>, <&ue7>;
            mods = <(MOD_LSFT)>;
        };

        n8ue8: n8ue8 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N8>, <&ue8>;
            mods = <(MOD_LSFT)>;
        };

        n9ue9: n9ue9 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N9>, <&ue9>;
            mods = <(MOD_LSFT)>;
        };

        tmux_next_pre: tmux_next_pre {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&tmux_next_window>, <&tmux_prev_window>;
            mods = <(MOD_LSFT)>;
        };

        mac_next_prev_app: mac_next_prev_app {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LG(TAB)>, <&kp LG(LS(TAB))>;
            mods = <(MOD_LSFT)>;
        };

        mac_prev_next_window: mac_prev_next_window {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LC(F9)>, <&kp LS(LC(F9))>;
            mods = <(MOD_LSFT)>;
        };

        swapper: swapper {
            compatible = "zmk,behavior-smart-toggle";
            #binding-cells = <0>;
            bindings = <&kp LGUI>, <&kp TAB>;
            ignored-key-positions = <37>;
        };
        // END behaviors
    };

    keymap {
        compatible = "zmk,keymap";

        // BEGIN keymap
        BASE {
            display-name = "BASE";
            bindings = <
&none &kp P &kp O &kp I &kp U &kp T &kp T &kp U &kp I &kp O &kp P &none
&none &lt 3 DE_S &kp A &kp E &kp N &kp R &kp R &kp N &kp E &kp A &lt 3 DE_S &none
&none &lh_ht LEFT_SHIFT D &lh_ht LCTRL DE_L &lh_ht LEFT_ALT DE_C &lh_ht LEFT_GUI DE_F &kp H &kp H &rh_ht LEFT_GUI DE_F &rh_ht LEFT_ALT DE_C &rh_ht LCTRL DE_L &rh_ht LEFT_SHIFT D &none
&sl 1 &sk LEFT_SHIFT &sl 2 &sl 2 &sk LEFT_SHIFT &sl 1
            >;
        };

        Nav1 {
            display-name = "Nav1";
            bindings = <
&tog 5 &B_UE &kp END &kp PG_UP &kp PG_DN &kp HOME &kp HOME &kp PG_DN &kp PG_UP &kp END &B_UE &tog 5
&none &B_OE &kp LEFT_ARROW &kp DOWN &kp UP &kp RIGHT_ARROW &kp RIGHT_ARROW &kp UP &kp DOWN &kp LEFT_ARROW &B_OE &none
&none &kp DE_A_UMLAUT &kp N9 &double_single_quote &back_front_tick &hash_pipe &hash_pipe &back_front_tick &double_single_quote &kp N9 &kp DE_A_UMLAUT &none
&trans &trans &trans &trans &trans &trans
            >;
        };

        Nav2 {
            display-name = "Nav2";
            bindings = <
&none &frage_ausrufe_zeichen &mac_prev_next_window &swapper &tmux_next_pre &kp LC(DE_U_UMLAUT) &kp LC(DE_U_UMLAUT) &tmux_next_pre &swapper &mac_prev_next_window &frage_ausrufe_zeichen &none
&none &at_equal &lCl &kCk &jCj &hCh &hCh &jCj &kCk &lCl &at_equal &none
&none &slash_backslash &dollar_ampersand &trans &prozent_ringli &daechli_tilde &daechli_tilde &prozent_ringli &trans &dollar_ampersand &slash_backslash &none
&trans &trans &trans &trans &trans &trans
            >;
        };

        Num {
            display-name = "Num";
            bindings = <
&none &trans &n3ue3 &n2ue2 &n1ue1 &minus_underscore &minus_underscore &n1ue1 &n2ue2 &n3ue3 &trans &none
&none &trans &n6ue6 &n5ue5 &n4ue4 &n0ue0 &n0ue0 &n4ue4 &n5ue5 &n6ue6 &trans &none
&none &trans &n9ue9 &n8ue8 &n7ue7 &mal_plus &mal_plus &n7ue7 &n8ue8 &n9ue9 &trans &none
&trans &trans &trans &trans &trans &trans
            >;
        };

        BT {
            display-name = "BT";
            bindings = <
&none &bt BT_CLR_ALL &bt BT_SEL 2 &bt BT_SEL 1 &bt BT_SEL 0 &bt BT_CLR &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR_ALL &none
&none &trans &trans &trans &out OUT_BLE &trans &trans &out OUT_BLE &trans &trans &trans &none
&none &esc_layerreset &trans &trans &out OUT_USB &bootloader &bootloader &out OUT_USB &trans &trans &esc_layerreset &none
&trans &trans &trans &trans &trans &trans
            >;
        };

        Vim {
            display-name = "Vim";
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans
            >;
        };

        NavVim {
            display-name = "NavVim";
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &kp H &kp J &kp K &kp L &kp L &kp K &kp J &kp H &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans
            >;
        };
        // END keymap
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        BT {
            if-layers = <1 2>;
            then-layer = <4>;
        };

        NavVim {
            if-layers = <1 5>;
            then-layer = <6>;
        };
    };
};
