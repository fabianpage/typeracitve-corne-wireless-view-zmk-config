        [:slash_backslash]
        [:dollar_ampersand]
        :trans
        [:prozent_ringli]
        [:daechli_tilde]]
       [:trans :trans :trans]]}
     {:name "Num",
      :left
      [[:none :trans [:n3ue3] [:n2ue2] [:n1ue1] [:minus_underscore]]
       [:none :trans [:n6ue6] [:n5ue5] [:n4ue4] [:n0ue0]]
       [:none :trans [:n9ue9] [:n8ue8] [:n7ue7] [:mal_plus]]
       [:trans :trans :trans]]}
     {:name "BT",
      :left
      [[:none [:bt :BT_CLR_ALL] [:bt :BT_SEL 2] [:bt :BT_SEL 1] [:bt :BT_SEL 0] [:bt :BT_CLR]]
       [:none :trans :trans :trans [:out :OUT_BLE] :trans]
       [:none
        [:esc_layerreset]
        :trans
        :trans
        [:out :OUT_USB]
        [:bootloader]]
       [:trans :trans :trans]]}
     {:name "Vim",
      :left
      [[:trans :trans :trans :trans :trans :trans]
       [:trans :trans :trans :trans :trans :trans]
       [:trans :trans :trans :trans :trans :trans]
       [:trans :trans :trans]]}
     {:name "NavVim",
      :left
      [[:trans :trans :trans :trans :trans :trans]
       [:trans :trans :H :J :K :L]
       [:trans :trans :trans :trans :trans :trans]
       [:trans :trans :trans]]})}]]}
