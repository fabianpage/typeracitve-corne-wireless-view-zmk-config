{:keyboard {:row-widths [12 12 12 6], :empty :trans}
 :regions
 [[:combos
   {:nodes
    ({:name "horiz_base"
      :type :combo-layer
      :pattern [[0 0] [0 1]]
      ;; :layers [:BASE],
      :left
      [[:DE_A_UMLAUT :DE_X :DE_W :DE_M :DE_Z :none]
       [:DE_O_UMLAUT :DE_Q :TAB :DE_G :DE_Y :none]
       [:DE_U_UMLAUT :DE_LESS_THAN :DE_GREATER_THAN [:kp "LA(DE_N8)"] [:kp "LA(DE_N9)"] :none]
       [:none :none :none]]
      :right-override
      [nil
       nil
       [:* [:kp "LA(DE_N8)"] [:kp "LA(DE_N9)"] :DE_LESS_THAN :DE_GREATER_THAN :*]
       nil]}
     {:name "vert_base"
      :type :combo-layer
      :pattern [[0 0] [1 0]]
      ;; :layers [:BASE]
