#include "keys_de_swiss.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

//&default_transform { col-offset = <0>; };

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    combos {
        compatible = "zmk,combos";

        // BEGIN combos
        horiz_base_0_0 {
            bindings = <&kp DE_A_UMLAUT>;
            key-positions = <0 1>;
        };

        horiz_base_0_1 {
            bindings = <&kp DE_X>;
            key-positions = <1 2>;
        };

        horiz_base_0_2 {
            bindings = <&kp DE_W>;
            key-positions = <2 3>;
        };

        horiz_base_0_3 {
            bindings = <&kp DE_M>;
            key-positions = <3 4>;
        };

        horiz_base_0_4 {
            bindings = <&kp DE_Z>;
            key-positions = <4 5>;
        };

        horiz_base_0_7 {
            bindings = <&kp DE_Z>;
            key-positions = <7 6>;
        };

        horiz_base_0_8 {
            bindings = <&kp DE_M>;
            key-positions = <8 7>;
        };

        horiz_base_0_9 {
            bindings = <&kp DE_W>;
            key-positions = <9 8>;
        };

        horiz_base_0_10 {
            bindings = <&kp DE_X>;
            key-positions = <10 9>;
        };

        horiz_base_0_11 {
            bindings = <&kp DE_A_UMLAUT>;
            key-positions = <11 10>;
        };

        horiz_base_1_0 {
            bindings = <&kp DE_O_UMLAUT>;
            key-positions = <12 13>;
        };

        horiz_base_1_1 {
            bindings = <&kp DE_Q>;
            key-positions = <13 14>;
        };

        horiz_base_1_2 {
            bindings = <&kp TAB>;
            key-positions = <14 15>;
        };

        horiz_base_1_3 {
            bindings = <&kp DE_G>;
            key-positions = <15 16>;
        };

        horiz_base_1_4 {
            bindings = <&kp DE_Y>;
            key-positions = <16 17>;
        };

        horiz_base_1_7 {
            bindings = <&kp DE_Y>;
            key-positions = <19 18>;
        };

        horiz_base_1_8 {
            bindings = <&kp DE_G>;
            key-positions = <20 19>;
        };

        horiz_base_1_9 {
            bindings = <&kp TAB>;
            key-positions = <21 20>;
        };

        horiz_base_1_10 {
            bindings = <&kp DE_Q>;
            key-positions = <22 21>;
        };

        horiz_base_1_11 {
            bindings = <&kp DE_O_UMLAUT>;
            key-positions = <23 22>;
        };

        horiz_base_2_0 {
            bindings = <&kp DE_U_UMLAUT>;
            key-positions = <24 25>;
        };

        horiz_base_2_1 {
            bindings = <&kp DE_LESS_THAN>;
            key-positions = <25 26>;
        };

        horiz_base_2_2 {
            bindings = <&kp DE_GREATER_THAN>;
            key-positions = <26 27>;
        };

        horiz_base_2_3 {
            bindings = <&kp LA(DE_N8)>;
            key-positions = <27 28>;
        };

        horiz_base_2_4 {
            bindings = <&kp LA(DE_N9)>;
            key-positions = <28 29>;
        };

        horiz_base_2_7 {
            bindings = <&kp LA(DE_N8)>;
            key-positions = <31 30>;
        };

        horiz_base_2_8 {
            bindings = <&kp LA(DE_N9)>;
            key-positions = <32 31>;
        };

        horiz_base_2_9 {
            bindings = <&kp DE_LESS_THAN>;
            key-positions = <33 32>;
        };

        horiz_base_2_10 {
            bindings = <&kp DE_GREATER_THAN>;
            key-positions = <34 33>;
        };

        horiz_base_2_11 {
            bindings = <&kp DE_U_UMLAUT>;
            key-positions = <35 34>;
        };

        vert_base_0_0 {
            bindings = <&backspace_delete>;
            key-positions = <0 12>;
        };

        vert_base_0_1 {
            bindings = <&kp DE_LEFT_PARENTHESIS>;
            key-positions = <1 13>;
        };

        vert_base_0_2 {
            bindings = <&kp DE_RIGHT_PARENTHESIS>;
            key-positions = <2 14>;
        };

        vert_base_0_3 {
            bindings = <&esc_layerreset>;
            key-positions = <3 15>;
        };

        vert_base_0_4 {
            bindings = <&sk LEFT_ALT>;
            key-positions = <4 16>;
        };

        vert_base_0_5 {
            bindings = <&sk LEFT_GUI>;
            key-positions = <5 17>;
        };

        vert_base_0_6 {
            bindings = <&sk LEFT_GUI>;
            key-positions = <6 18>;
        };

        vert_base_0_7 {
            bindings = <&sk LEFT_ALT>;
            key-positions = <7 19>;
        };

        vert_base_0_8 {
            bindings = <&esc_layerreset>;
            key-positions = <8 20>;
        };

        vert_base_0_9 {
            bindings = <&kp DE_LEFT_PARENTHESIS>;
            key-positions = <9 21>;
        };

        vert_base_0_10 {
            bindings = <&kp DE_RIGHT_PARENTHESIS>;
            key-positions = <10 22>;
        };

        vert_base_0_11 {
            bindings = <&backspace_delete>;
            key-positions = <11 23>;
        };

        vert_base_1_0 {
            bindings = <&kp ENTER>;
            key-positions = <12 24>;
        };

        vert_base_1_1 {
            bindings = <&kp LA(DE_N5)>;
            key-positions = <13 25>;
        };

        vert_base_1_2 {
            bindings = <&kp LA(DE_N6)>;
            key-positions = <14 26>;
        };

        vert_base_1_3 {
            bindings = <&kp SPACE>;
            key-positions = <15 27>;
        };

        vert_base_1_4 {
            bindings = <&sk LEFT_SHIFT>;
            key-positions = <16 28>;
        };

        vert_base_1_5 {
            bindings = <&sk LCTRL>;
            key-positions = <17 29>;
        };

        vert_base_1_6 {
            bindings = <&sk LCTRL>;
            key-positions = <18 30>;
        };

        vert_base_1_7 {
            bindings = <&sk LEFT_SHIFT>;
            key-positions = <19 31>;
        };

        vert_base_1_8 {
            bindings = <&kp SPACE>;
            key-positions = <20 32>;
        };

        vert_base_1_9 {
            bindings = <&kp LA(DE_N5)>;
            key-positions = <21 33>;
        };

        vert_base_1_10 {
            bindings = <&kp LA(DE_N6)>;
            key-positions = <22 34>;
        };

        vert_base_1_11 {
            bindings = <&kp ENTER>;
            key-positions = <23 35>;
        };

        diag_down_base_0_3 {
            bindings = <&punkt_doppelpunkt>;
            key-positions = <3 16>;
        };

        diag_down_base_0_8 {
            bindings = <&punkt_doppelpunkt>;
            key-positions = <8 19>;
        };

        diag_down_base_1_3 {
            bindings = <&komma_strickpunkt>;
            key-positions = <15 28>;
        };

        diag_down_base_1_8 {
            bindings = <&komma_strickpunkt>;
            key-positions = <20 31>;
        };

        toBT {
            bindings = <&to 4>;
            key-positions = <1 2 3 4>;
            layers = <0>;
        };

        ae {
            bindings = <&M_UPPER_AEOEUE DE_A_UMLAUT>;
            key-positions = <36 25 37>;
            layers = <0>;
        };
        // END combos
    };

    macros {
        // BEGIN macros
        esc_layerreset: esc_layerreset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE &to 0>;
        };

        daechli: daechli {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_CARET &kp SPACE>;
        };

        tilde: tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(DE_N) &kp SPACE>;
        };

        punkt_doppelpunkt: punkt_doppelpunkt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_DOT>, <&kp DE_COLON>;
            mods = <(MOD_LSFT)>;
        };

        komma_strickpunkt: komma_strickpunkt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_COMMA>, <&kp DE_SEMICOLON>;
            mods = <(MOD_LSFT)>;
        };

        M_UPPER_AEOEUE: AE {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&kp CAPSLOCK>,
                <&macro_pause_for_release>,
                <&macro_param_1to1>,
                <&kp MACRO_PLACEHOLDER>,
                <&kp CAPSLOCK>;
            wait-ms = <80>;
            tap-ms = <80>;
        };

        M_UE: M_UE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CAPSLOCK &kp DE_U_UMLAUT &kp CAPSLOCK>;
            wait-ms = <20>;
            tap-ms = <20>;
        };

        M_OE: M_OE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CAPSLOCK &kp DE_O_UMLAUT &kp CAPSLOCK>;
            wait-ms = <100>;
            tap-ms = <100>;
        };

        backtick_macro: backtick_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_GRAVE &kp SPACE>;
        };

        fronttick_macro: fronttick_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(EQUAL) &kp SPACE>;
        };

        ue1: ue1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT &kp DE_N1>;
        };

        ue2: ue2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT &kp DE_N2>;
        };

        ue3: ue3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT &kp DE_N3>;
        };

        ue4: ue4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT &kp DE_N4>;
        };

        ue5: ue5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT &kp DE_N5>;
        };

        ue6: ue6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT &kp DE_N6>;
        };

        ue7: ue7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT &kp DE_N7>;
        };

        ue8: ue8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT &kp DE_N8>;
        };

        ue9: ue9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT &kp DE_N9>;
        };

        ue0: ue0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT &kp DE_N0>;
        };

        tmux_next_window: tmux_next_window {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT &kp DE_N>;
        };

        tmux_prev_window: tmux_prev_window {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT &kp DE_P>;
        };

        vim_split_v: vim_split_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(W) &kp V>;
        };

        vim_split_s: vim_split_s {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(W) &kp S>;
        };
        // END macros
    };

    behaviors {
        // BEGIN behaviors
        lh_ht: lh_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35>;
            flavor = "balanced";
            hold-trigger-on-release;
            quick-tap-ms = <150>;
            global-quick-tap;
            tapping-term-ms = <200>;
        };

        rh_ht: rh_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29>;
            flavor = "balanced";
            hold-trigger-on-release;
            quick-tap-ms = <150>;
            global-quick-tap;
            tapping-term-ms = <200>;
        };

        mal_plus: mal_plus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_ASTERISK>, <&kp DE_PLUS>;
            mods = <(MOD_LSFT)>;
        };

        minus_underscore: minus_underscore {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_MINUS>, <&kp DE_UNDER>;
            mods = <(MOD_LSFT)>;
        };

        n0ue0: n0ue0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N0>, <&ue0>;
            mods = <(MOD_LSFT)>;
        };

        n1ue1: n1ue1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N1>, <&ue1>;
            mods = <(MOD_LSFT)>;
        };

        n2ue2: n2ue2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N2>, <&ue2>;
            mods = <(MOD_LSFT)>;
        };

        n3ue3: n3ue3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N3>, <&ue3>;
            mods = <(MOD_LSFT)>;
        };

        n4ue4: n4ue4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N4>, <&ue4>;
            mods = <(MOD_LSFT)>;
        };

        n5ue5: n5ue5 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N5>, <&ue5>;
            mods = <(MOD_LSFT)>;
        };

        n6ue6: n6ue6 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N6>, <&ue6>;
            mods = <(MOD_LSFT)>;
        };

        n7ue7: n7ue7 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N7>, <&ue7>;
            mods = <(MOD_LSFT)>;
        };

        n8ue8: n8ue8 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N8>, <&ue8>;
            mods = <(MOD_LSFT)>;
        };

        n9ue9: n9ue9 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N9>, <&ue9>;
            mods = <(MOD_LSFT)>;
        };

        backspace_delete: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;
            mods = <(MOD_LSFT)>;
        };

        tmux_next_pre: tmux_next_pre {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&tmux_next_window>, <&tmux_prev_window>;
            mods = <(MOD_LSFT)>;
        };
        // END behaviors
    };

    keymap {
        compatible = "zmk,keymap";

        // BEGIN keymap
        BASE {
            display-name = "BASE";
            bindings = <
&kp K &kp P &kp O &kp I &kp U &kp T &kp T &kp U &kp I &kp O &kp P &kp K
&kp J &lt 3 S &kp A &kp E &kp N &kp R &kp R &kp N &kp E &kp A &lt 3 S &kp J
&kp B &lh_ht LEFT_SHIFT D &lh_ht LCTRL DE_L &lh_ht LEFT_ALT DE_C &lh_ht LEFT_GUI DE_F &kp H &kp H &rh_ht LEFT_GUI DE_F &rh_ht LEFT_ALT DE_C &rh_ht LCTRL DE_L &rh_ht LEFT_SHIFT D &kp B
&sl 1 &kp V &sl 2 &sl 2 &kp V &sl 1
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
&tog 5 &vim_split_v &kp END &kp PG_UP &kp PG_DN &kp HOME &kp HOME &kp PG_DN &kp PG_UP &kp END &vim_split_v &tog 5
&none &vim_split_s &kp LEFT_ARROW &kp DOWN_ARROW &kp UP_ARROW &kp RIGHT_ARROW &kp LEFT_ARROW &kp DOWN_ARROW &kp UP_ARROW &kp RIGHT_ARROW &vim_split_s &none
&none &none &kp H &kp J &kp K &kp L &kp H &kp J &kp K &kp L &none &none
&trans &trans &trans &trans &trans &trans
            >;
        };

        sym {
            display-name = "sym";
            bindings = <
&kp DE_EXCLAMATION &kp DE_QUESTION &backtick_macro &fronttick_macro &kp DE_SINGLE_QUOTE &kp DE_DOUBLE_QUOTES &kp DE_DOUBLE_QUOTES &kp DE_SINGLE_QUOTE &fronttick_macro &backtick_macro &kp DE_QUESTION &kp DE_EXCLAMATION
&kp DE_EQUAL &kp LA(DE_G) &kp DE_HASH &kp DE_DOLLAR &kp DE_PERCENT &tilde &tilde &kp DE_PERCENT &kp DE_DOLLAR &kp DE_HASH &kp LA(DE_G) &kp DE_EQUAL
&kp DE_SLASH &kp LA(LS(DE_N7)) &kp DE_PIPE &kp DE_AMPERSAND &kp LS(DE_SECTION) &daechli &daechli &kp LS(DE_SECTION) &kp DE_AMPERSAND &kp DE_PIPE &kp LA(LS(DE_N7)) &kp DE_SLASH
&trans &trans &trans &trans &trans &trans
            >;
        };

        Num {
            display-name = "Num";
            bindings = <
&none &trans &n3ue3 &n2ue2 &n1ue1 &minus_underscore &minus_underscore &n1ue1 &n2ue2 &n3ue3 &trans &none
&none &trans &n6ue6 &n5ue5 &n4ue4 &n0ue0 &n0ue0 &n4ue4 &n5ue5 &n6ue6 &trans &none
&none &trans &n9ue9 &n8ue8 &n7ue7 &mal_plus &mal_plus &n7ue7 &n8ue8 &n9ue9 &trans &none
&trans &trans &trans &trans &trans &trans
            >;
        };

        BT {
            display-name = "BT";
            bindings = <
&none &bt BT_CLR_ALL &bt BT_SEL 2 &bt BT_SEL 1 &bt BT_SEL 0 &bt BT_CLR &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR_ALL &none
&none &trans &trans &trans &out OUT_BLE &trans &trans &out OUT_BLE &trans &trans &trans &none
&none &esc_layerreset &trans &trans &out OUT_USB &bootloader &bootloader &out OUT_USB &trans &trans &esc_layerreset &none
&trans &trans &trans &trans &trans &trans
            >;
        };

        Vim {
            display-name = "Vim";
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans
            >;
        };

        NavVim {
            display-name = "NavVim";
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &kp H &kp J &kp K &kp L &kp H &kp J &kp K &kp L &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans
            >;
        };
        // END keymap
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        BT {
            if-layers = <1 2>;
            then-layer = <4>;
        };

        NavVim {
            if-layers = <1 5>;
            then-layer = <6>;
        };
    };
};
