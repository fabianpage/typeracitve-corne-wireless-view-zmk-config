{:keyboard {:row-widths [12 12 12 6], :empty :trans},
 :regions
 [[:combos
   {:nodes
    ({:name "horiz_base",
      :type :combo-layer,
      :pattern [[0 0] [0 1]],
      ;; :layers [:BASE],
      :left
      [[:none :DE_X :DE_W :DE_M :DE_Z :none]
       [:none :DE_Q :TAB :DE_V :DE_G :none]
       [:none :DE_Y :DE_K :DE_J :DE_B :none]
       [:none :none :none]]}
     {:name "vert_base",
      :type :combo-layer,
      :pattern [[0 0] [1 0]],
      :layers [:BASE],
      :left
      [[:none [:backspace_delete] [:round_brackets] [:esc_layerreset] [:sk :LEFT_ALT] [:sk :LEFT_GUI]]
       [:none :ENTER [:square_brackets] :SPACE [:caps_word] [:sk :LCTRL] ]
       [:none :none :none :none :none :none]
       [:none :none :none]]}
     {:name "diag_down_base",
      :type :combo-layer,
      :pattern [[0 0] [1 1]],
      :layers [:BASE],
      :left
      [[:none :none :none [:punkt_doppelpunkt]  [:curly_brackets] :none]
       [:none :none :none  [:komma_strickpunkt] [:angled_brackets] :none]
       [:none :none :none :none :none :none]
       [:none :none :none]]}
     {:name "diag_up_base",
      :type :combo-layer,
      :pattern [[0 0] [-1 -1]],
      :layers [:BASE],
      :left
      [[:none :none :none :none :none :none]
       [:none :none :none :none [:curly_brackets] :none]
       [:none :none :none :SPACE :none :none]
       [:none :none :none]]}
    ;;  {:name "diag_knight_base",
    ;;   :type :combo-layer,
    ;;   :pattern [[0 0] [-1 -2]],
    ;;   :layers [:BASE],
    ;;   :left
    ;;   [[:none :none :none :none :none :none]
    ;;    [:none :none :none :none :none :none]
    ;;    [:none :none :none :none [:komma_strickpunkt] [:angled_brackets]]
    ;;    [:none :none :none]]}
     {:name "toBT",
      :body
      ["bindings = <&to 4>;"
       "key-positions = <1 2 3 4>;"
       "layers = <0>;"]}
     {:name "ae",
      :body
      ["bindings = <&M_UPPER_AEOEUE DE_A_UMLAUT>;"
       "key-positions = <36 25 37>;"
       "layers = <0>;"]})}]
  [:macros
   {:nodes
    [{:name "esc_layerreset", :type :macro, :bindings [:ESCAPE [:to 0]]}
     {:name "daechli", :type :macro, :bindings [:DE_CARET :SPACE]}
     {:name "tilde", :type :macro, :bindings [[:kp "LA(DE_N)"] :SPACE]}
     {:name "M_UPPER_AEOEUE",
      :label "AE",
      :type :macro-one-param,
      :wait-ms 80,
      :tap-ms 80,
      :bindings
      [:CAPSLOCK [:pause] [:param-1to1 [:kp :_placeholder]] :CAPSLOCK]}
     {:name "M_UE",
      :type :macro,
      :bindings [:CAPSLOCK :DE_U_UMLAUT :CAPSLOCK],
      :wait-ms 20,
      :tap-ms 20}
     {:name "M_OE",
      :type :macro,
      :bindings [:CAPSLOCK :DE_O_UMLAUT :CAPSLOCK],
      :wait-ms 100,
      :tap-ms 100}
     {:name "backtick_macro", :type :macro, :bindings [:DE_GRAVE :SPACE]}
     {:name "fronttick_macro", :type :macro, :bindings [[:kp "RA(EQUAL)"] :SPACE]}
     {:name "ue1", :type :macro, :bindings [:DE_U_UMLAUT :DE_N1]}
     {:name "ue2", :type :macro, :bindings [:DE_U_UMLAUT :DE_N2]}
     {:name "ue3", :type :macro, :bindings [:DE_U_UMLAUT :DE_N3]}
     {:name "ue4", :type :macro, :bindings [:DE_U_UMLAUT :DE_N4]}
     {:name "ue5", :type :macro, :bindings [:DE_U_UMLAUT :DE_N5]}
     {:name "ue6", :type :macro, :bindings [:DE_U_UMLAUT :DE_N6]}
     {:name "ue7", :type :macro, :bindings [:DE_U_UMLAUT :DE_N7]}
     {:name "ue8", :type :macro, :bindings [:DE_U_UMLAUT :DE_N8]}
     {:name "ue9", :type :macro, :bindings [:DE_U_UMLAUT :DE_N9]}
     {:name "ue0", :type :macro, :bindings [:DE_U_UMLAUT :DE_N0]}
     {:name "tmux_next_window", :type :macro, :bindings [:DE_U_UMLAUT :DE_N]}
     {:name "tmux_prev_window", :type :macro, :bindings [:DE_U_UMLAUT :DE_P]}]}]
  [:behaviors
   {:nodes
    [{:name "lh_ht"
      :type :hold-tap
      :bindings ["&kp" "&kp"]
      :flavor "balanced"
      :tapping-term-ms 200
      :quick-tap-ms 150
      :global-quick-tap true
      :hold-trigger-on-release true
      :hold-trigger-key-positions :right-half}
     {:name "rh_ht"
      :type :hold-tap
      :bindings ["&kp" "&kp"]
      :flavor "balanced"
      :tapping-term-ms 200
      :quick-tap-ms 150
      :global-quick-tap true
      :hold-trigger-on-release true
      :hold-trigger-key-positions :left-half}
     {:name "square_brackets",
      :type :mod-morph,
      :bindings ["&kp LA(DE_N5)" "&kp LA(DE_N6)"],
      :mods "(MOD_LSFT)"}
     {:name "round_brackets",
      :type :mod-morph,
      :bindings ["&kp LS(DE_N8)" "&kp LS(DE_N9)"],
      :mods "(MOD_LSFT)"}
     {:name "angled_brackets",
      :type :mod-morph,
      :bindings [:DE_LESS_THAN :DE_GREATER_THAN],
      :mods "(MOD_LSFT)"}
     {:name "curly_brackets",
      :type :mod-morph,
      :bindings ["&kp LA(DE_N8)" "&kp LA(DE_N9)"],
      :mods "(MOD_LSFT)"}
     {:name "backspace_delete",
      :type :mod-morph,
      :bindings [:BACKSPACE :DELETE],
      :mods "(MOD_LSFT)"}
     {:name "double_single_quote",
      :type :mod-morph,
      :bindings [:DE_DOUBLE_QUOTES :MINUS],
      :mods "(MOD_LSFT)"}
     {:name "back_front_tick",
      :type :mod-morph,
      :bindings [[:backtick_macro] [:fronttick_macro]],
      :mods "(MOD_LSFT)"}
     {:name "punkt_doppelpunkt",
      :type :mod-morph,
      :bindings [:DE_DOT :DE_COLON],
      :mods "(MOD_LSFT)"}
     {:name "komma_strickpunkt",
      :type :mod-morph,
      :bindings [:DE_COMMA :DE_SEMICOLON],
      :mods "(MOD_LSFT)"}
     {:name "frage_ausrufe_zeichen",
      :type :mod-morph,
      :bindings [:DE_QUESTION :DE_EXCLAMATION],
      :mods "(MOD_LSFT)"}
     {:name "daechli_tilde",
      :type :mod-morph,
      :bindings [[:daechli] [:tilde]],
      :mods "(MOD_LSFT)"}
     {:name "prozent_ringli",
      :type :mod-morph,
      :bindings [:DE_PERCENT "&kp LS(NON_US_BSLH)"],
      :mods "(MOD_LSFT)"}
     {:name "hash_pipe",
      :type :mod-morph,
      :bindings [:DE_HASH :DE_PIPE],
      :mods "(MOD_LSFT)"}
     {:name "at_equal",
      :type :mod-morph,
      :bindings ["&kp LA(DE_G)" :DE_EQUAL],
      :mods "(MOD_LSFT)"}
     {:name "dollar_ampersand",
      :type :mod-morph,
      :bindings [:DE_DOLLAR :DE_AMPERSAND],
      :mods "(MOD_LSFT)"}
     {:name "slash_backslash",
      :type :mod-morph,
      :bindings [:DE_SLASH "&kp LS(LA(DE_N7))"],
      :mods "(MOD_LSFT)"}
     {:name "mal_plus",
      :type :mod-morph,
      :bindings [:DE_ASTERISK :DE_PLUS],
      :mods "(MOD_LSFT)"}
     {:name "minus_underscore",
      :type :mod-morph,
      :bindings [:DE_MINUS :DE_UNDER],
      :mods "(MOD_LSFT)"}
     {:name "B_AE",
      :type :mod-morph,
      :bindings [:DE_A_UMLAUT [:M_UPPER_AEOEUE :DE_A_UMLAUT]],
      :mods "(MOD_LSFT)"}
     {:name "B_UE",
      :type :mod-morph,
      :bindings [:DE_U_UMLAUT [:M_UE]],
      :mods "(MOD_LSFT)"}
     {:name "B_OE",
      :type :mod-morph,
      :bindings [:DE_O_UMLAUT [:M_OE]],
      :mods "(MOD_LSFT)"}
     {:name "hCh",
      :type :mod-morph,
      :bindings [:DE_H "&kp LC(DE_H)"],
      :mods "(MOD_LSFT)"}
     {:name "jCj",
      :type :mod-morph,
      :bindings [:DE_J "&kp LC(DE_J)"],
      :mods "(MOD_LSFT)"}
     {:name "kCk",
      :type :mod-morph,
      :bindings [:DE_K "&kp LC(DE_K)"],
      :mods "(MOD_LSFT)"}
     {:name "lCl",
      :type :mod-morph,
      :bindings [:DE_L "&kp LC(DE_L)"],
      :mods "(MOD_LSFT)"}
     {:name "n0ue0",
      :type :mod-morph,
      :bindings [:DE_N0 [:ue0]],
      :mods "(MOD_LSFT)"}
     {:name "n1ue1",
      :type :mod-morph,
      :bindings [:DE_N1 [:ue1]],
      :mods "(MOD_LSFT)"}
     {:name "n2ue2",
      :type :mod-morph,
      :bindings [:DE_N2 [:ue2]],
      :mods "(MOD_LSFT)"}
     {:name "n3ue3",
      :type :mod-morph,
      :bindings [:DE_N3 [:ue3]],
      :mods "(MOD_LSFT)"}
     {:name "n4ue4",
      :type :mod-morph,
      :bindings [:DE_N4 [:ue4]],
      :mods "(MOD_LSFT)"}
     {:name "n5ue5",
      :type :mod-morph,
      :bindings [:DE_N5 [:ue5]],
      :mods "(MOD_LSFT)"}
     {:name "n6ue6",
      :type :mod-morph,
      :bindings [:DE_N6 [:ue6]],
      :mods "(MOD_LSFT)"}
     {:name "n7ue7",
      :type :mod-morph,
      :bindings [:DE_N7 [:ue7]],
      :mods "(MOD_LSFT)"}
     {:name "n8ue8",
      :type :mod-morph,
      :bindings [:DE_N8 [:ue8]],
      :mods "(MOD_LSFT)"}
     {:name "n9ue9",
      :type :mod-morph,
      :bindings [:DE_N9 [:ue9]],
      :mods "(MOD_LSFT)"}
     {:name "tmux_next_pre",
      :type :mod-morph,
      :bindings [[:tmux_next_window] [:tmux_prev_window]],
      :mods "(MOD_LSFT)"}
     {:name "mac_next_prev_app",
      :type :mod-morph,
      :bindings ["&kp LG(TAB)" "&kp LG(LS(TAB))"],
      :mods "(MOD_LSFT)"}
     {:name "mac_prev_next_window",
      :type :mod-morph,
      :bindings ["&kp LC(F9)" "&kp LS(LC(F9))"],
      :mods "(MOD_LSFT)"}
     {:name "swapper",
      :type :smart-toggle,
      :bindings [:LGUI :TAB],
      :ignored-key-positions "37"}]}]
  [:keymap
   {:nodes
    ({:name "BASE",
      :left
      [[:none :P :O :I :U :T]
       [:none [:lt 3 :DE_S] :A :E :N :R]
       [:none [:lh_ht :LEFT_SHIFT :D] [:lh_ht :LCTRL :DE_L] [:lh_ht :LEFT_ALT :DE_C] [:lh_ht :LEFT_GUI :DE_F] :H]
       [[:sl 1] [:sk :LEFT_SHIFT] [:sl 2]]]
      :right-override
