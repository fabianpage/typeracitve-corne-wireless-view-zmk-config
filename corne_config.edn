{:keyboard {:row-widths [12 12 12 6], :empty :trans}
 :regions
 [[:combos
   {:nodes
    ({:name "horiz_base"
      :type :combo-layer
      :pattern [[0 0] [0 1]]
      ;; :layers [:BASE],
      :left
      [[:DE_A_UMLAUT :DE_X :DE_W :DE_M :DE_Z :none]
       [:DE_O_UMLAUT :DE_Q :TAB :DE_G :DE_Y :none]
       [:DE_U_UMLAUT :DE_LESS_THAN :DE_GREATER_THAN [:kp "LA(DE_N8)"] [:kp "LA(DE_N9)"] :none]
       [:none :none :none]]
      :right-override
      [nil
       nil
       [:* [:kp "LA(DE_N8)"] [:kp "LA(DE_N9)"] :DE_LESS_THAN :DE_GREATER_THAN :*]
       nil]}
     {:name "vert_base"
      :type :combo-layer
      :pattern [[0 0] [1 0]]
      ;; :layers [:BASE]
      ;;
      ; :bindings ["&kp LS(DE_N8)" "&kp LS(DE_N9)"]
      :left
      ; [[[:backspace_delete] [:kp "LS(DE_N8)"] [:kp "LS(DE_N9)"] [:esc_layerreset] [:sk :LEFT_ALT] [:sk :LEFT_GUI]]
      [[[:backspace_delete] :DE_LEFT_PARENTHESIS :DE_RIGHT_PARENTHESIS [:esc_layerreset] [:sk :LEFT_ALT] [:sk :LEFT_GUI]]
       [:ENTER [:kp "LA(DE_N5)"] [:kp "LA(DE_N6)"] :SPACE [:sk :LEFT_SHIFT] [:sk :LCTRL]]
       [:none :none :none :none :none :none]
       [:none :none :none]]
      :right-override
      [[:* :* :* :DE_LEFT_PARENTHESIS :DE_RIGHT_PARENTHESIS :*]
       [:*  :* :* [:kp "LA(DE_N5)"] [:kp "LA(DE_N6)"]  :*]
       nil
       nil]}


     {:name "diag_down_base"
      :type :combo-layer
      :pattern [[0 0] [1 1]]
      ;; :layers [:BASE]
      :left
      [[:none :none :none [:punkt_doppelpunkt]  :none :none]
       [:none :none :none  [:komma_strickpunkt] :none :none]
       [:none :none :none :none :none :none]
       [:none :none :none]]}
     {:name "toBT"
      :body
      ["bindings = <&to 4>;"
       "key-positions = <1 2 3 4>;"
       "layers = <0>;"]}
     {:name "ae"
      :body
      ["bindings = <&M_UPPER_AEOEUE DE_A_UMLAUT>;"
       "key-positions = <36 25 37>;"
       "layers = <0>;"]}

     ;; Num layer: hold V (pos 37) + a digit -> ue<digit> macro.
     ;; The Num layer is mirrored, so each digit has a left and a right
     ;; position; both are wired up so either hand works.
     {:name "ue1_l", :body ["bindings = <&ue1>;" "key-positions = <37 4>;"], :layers [:Num]}
     {:name "ue1_r", :body ["bindings = <&ue1>;" "key-positions = <37 7>;"], :layers [:Num]}
     {:name "ue2_l", :body ["bindings = <&ue2>;" "key-positions = <37 3>;"], :layers [:Num]}
     {:name "ue2_r", :body ["bindings = <&ue2>;" "key-positions = <37 8>;"], :layers [:Num]}
     {:name "ue3_l", :body ["bindings = <&ue3>;" "key-positions = <37 2>;"], :layers [:Num]}
     {:name "ue3_r", :body ["bindings = <&ue3>;" "key-positions = <37 9>;"], :layers [:Num]}
     {:name "ue4_l", :body ["bindings = <&ue4>;" "key-positions = <37 16>;"], :layers [:Num]}
     {:name "ue4_r", :body ["bindings = <&ue4>;" "key-positions = <37 19>;"], :layers [:Num]}
     {:name "ue5_l", :body ["bindings = <&ue5>;" "key-positions = <37 15>;"], :layers [:Num]}
     {:name "ue5_r", :body ["bindings = <&ue5>;" "key-positions = <37 20>;"], :layers [:Num]}
     {:name "ue6_l", :body ["bindings = <&ue6>;" "key-positions = <37 14>;"], :layers [:Num]}
     {:name "ue6_r", :body ["bindings = <&ue6>;" "key-positions = <37 21>;"], :layers [:Num]}
     {:name "ue7_l", :body ["bindings = <&ue7>;" "key-positions = <37 28>;"], :layers [:Num]}
     {:name "ue7_r", :body ["bindings = <&ue7>;" "key-positions = <37 31>;"], :layers [:Num]}
     {:name "ue8_l", :body ["bindings = <&ue8>;" "key-positions = <37 27>;"], :layers [:Num]}
     {:name "ue8_r", :body ["bindings = <&ue8>;" "key-positions = <37 32>;"], :layers [:Num]}
     {:name "ue9_l", :body ["bindings = <&ue9>;" "key-positions = <37 26>;"], :layers [:Num]}
     {:name "ue9_r", :body ["bindings = <&ue9>;" "key-positions = <37 33>;"], :layers [:Num]}
     {:name "ue0_l", :body ["bindings = <&ue0>;" "key-positions = <37 17>;"], :layers [:Num]}
     {:name "ue0_r", :body ["bindings = <&ue0>;" "key-positions = <37 18>;"], :layers [:Num]}

     ;; Num layer: hold V (pos 37) + '-' -> '_', + '*' -> '+'.
     {:name "under_l", :body ["bindings = <&kp DE_UNDER>;" "key-positions = <37 5>;"], :layers [:Num]}
     {:name "under_r", :body ["bindings = <&kp DE_UNDER>;" "key-positions = <37 6>;"], :layers [:Num]}
     {:name "plus_l", :body ["bindings = <&kp DE_PLUS>;" "key-positions = <37 29>;"], :layers [:Num]}
     {:name "plus_r", :body ["bindings = <&kp DE_PLUS>;" "key-positions = <37 30>;"], :layers [:Num]})}]
  [:macros
   {:nodes
    [{:name "esc_layerreset", :type :macro, :bindings [:ESCAPE [:to 0]]}
     {:name "daechli", :type :macro, :bindings [:DE_CARET :SPACE]}
     {:name "tilde", :type :macro, :bindings [[:kp "LA(DE_N)"] :SPACE]}
     {:name "punkt_doppelpunkt"
      :type :mod-morph
      :bindings [:DE_DOT :DE_COLON]
      :mods "(MOD_LSFT)"}
     {:name "komma_strickpunkt"
      :type :mod-morph
      :bindings [:DE_COMMA :DE_SEMICOLON]
      :mods "(MOD_LSFT)"}
     {:name "M_UPPER_AEOEUE"
      :label "AE"
      :type :macro-one-param
      :wait-ms 80
      :tap-ms 80
      :bindings
      [:CAPSLOCK [:pause] [:param-1to1 [:kp :_placeholder]] :CAPSLOCK]}
     {:name "M_UE"
      :type :macro
      :bindings [:CAPSLOCK :DE_U_UMLAUT :CAPSLOCK]
      :wait-ms 20
      :tap-ms 20}
     {:name "M_OE"
      :type :macro
      :bindings [:CAPSLOCK :DE_O_UMLAUT :CAPSLOCK]
      :wait-ms 100
      :tap-ms 100}
     {:name "backtick_macro", :type :macro, :bindings [:DE_GRAVE :SPACE]}
     {:name "fronttick_macro", :type :macro, :bindings [[:kp "RA(EQUAL)"] :SPACE]}
     {:name "ue1", :type :macro, :bindings [:DE_U_UMLAUT :DE_N1]}
     {:name "ue2", :type :macro, :bindings [:DE_U_UMLAUT :DE_N2]}
     {:name "ue3", :type :macro, :bindings [:DE_U_UMLAUT :DE_N3]}
     {:name "ue4", :type :macro, :bindings [:DE_U_UMLAUT :DE_N4]}
     {:name "ue5", :type :macro, :bindings [:DE_U_UMLAUT :DE_N5]}
     {:name "ue6", :type :macro, :bindings [:DE_U_UMLAUT :DE_N6]}
     {:name "ue7", :type :macro, :bindings [:DE_U_UMLAUT :DE_N7]}
     {:name "ue8", :type :macro, :bindings [:DE_U_UMLAUT :DE_N8]}
     {:name "ue9", :type :macro, :bindings [:DE_U_UMLAUT :DE_N9]}
     {:name "ue0", :type :macro, :bindings [:DE_U_UMLAUT :DE_N0]}
     {:name "tmux_next_window", :type :macro, :bindings [:DE_U_UMLAUT :DE_N]}
     {:name "tmux_prev_window", :type :macro, :bindings [:DE_U_UMLAUT :DE_P]}
     {:name "vim_split_v", :type :macro, :bindings [[:kp "LC(W)"] :V]}
     {:name "vim_split_s", :type :macro, :bindings [[:kp "LC(W)"] :S]}]}]
  [:behaviors
   {:nodes
    [{:name "lh_ht"
      :type :hold-tap
      :bindings ["&kp" "&kp"]
      :flavor "balanced"
      :tapping-term-ms 200
      :quick-tap-ms 150
      :global-quick-tap true
      :hold-trigger-on-release true
      :hold-trigger-key-positions :right-half}
     {:name "rh_ht"
      :type :hold-tap
      :bindings ["&kp" "&kp"]
      :flavor "balanced"
      :tapping-term-ms 200
      :quick-tap-ms 150
      :global-quick-tap true
      :hold-trigger-on-release true
      :hold-trigger-key-positions :left-half}
     {:name "backspace_delete"
      :type :mod-morph
      :bindings [:BACKSPACE :DELETE]
      :mods "(MOD_LSFT)"}
     {:name "tmux_next_pre"
      :type :mod-morph
      :bindings [[:tmux_next_window] [:tmux_prev_window]]
      :mods "(MOD_LSFT)"}]}]
  [:keymap
   {:nodes
    ({:name "BASE"
      :left
      [[:K :P :O :I :U :T]
       [:J [:lt 3 :S] :A :E :N :R]
       [:B [:lh_ht :LEFT_SHIFT :D] [:lh_ht :LCTRL :DE_L] [:lh_ht :LEFT_ALT :DE_C] [:lh_ht :LEFT_GUI :DE_F] :H]
       [[:sl 1] :V [:sl 2]]]
      :right-override
      [nil
       nil
       [:H [:rh_ht :LEFT_GUI :DE_F] [:rh_ht :LEFT_ALT :DE_C] [:rh_ht :LCTRL :DE_L] [:rh_ht :LEFT_SHIFT :D] :B]
       nil]}
     {:name "Nav"
      :left
      [[[:tog 5] [:vim_split_v] :END :PG_UP :PG_DN :HOME]
       [:none [:vim_split_s] :LEFT_ARROW :DOWN_ARROW :UP_ARROW :RIGHT_ARROW]
       [:none :none :H :J :K :L] [:trans :trans :trans]]
      :right-override
      [nil
       [:LEFT_ARROW :DOWN_ARROW :UP_ARROW :RIGHT_ARROW :* :*]
       [:H :J :K :L :* :*]
       nil]}
     {:name "sym"
      :left
      [[:DE_EXCLAMATION :DE_QUESTION [:backtick_macro] [:fronttick_macro] :DE_SINGLE_QUOTE :DE_DOUBLE_QUOTES]
       [:DE_EQUAL [:kp "LA(DE_G)"] :DE_HASH :DE_DOLLAR :DE_PERCENT [:tilde]]
       [:DE_SLASH [:kp "LA(LS(DE_N7))"] :DE_PIPE :DE_AMPERSAND [:kp "LS(DE_SECTION)"] [:daechli]]
       [:trans :trans :trans]]}
     {:name "Num"
      :left
      [[:none :trans :DE_N3 :DE_N2 :DE_N1 :DE_MINUS]
       [:none :trans :DE_N6 :DE_N5 :DE_N4 :DE_N0]
       [:none :trans :DE_N9 :DE_N8 :DE_N7 :DE_ASTERISK]
       [:trans :trans :trans]]}
     {:name "BT"
      :left
      [[:none [:bt :BT_CLR_ALL] [:bt :BT_SEL 2] [:bt :BT_SEL 1] [:bt :BT_SEL 0] [:bt :BT_CLR]]
       [:none :trans :trans :trans [:out :OUT_BLE] :trans]
       [:none [:esc_layerreset] :trans :trans [:out :OUT_USB] [:bootloader]]
       [:trans :trans :trans]]}
     {:name "Vim"
      :left
      [[:trans :trans :trans :trans :trans :trans]
       [:trans :trans :trans :trans :trans :trans]
       [:trans :trans :trans :trans :trans :trans]
       [:trans :trans :trans]]}
     {:name "NavVim"
      :left
      [[:trans :trans :trans :trans :trans :trans]
       [:trans :trans :H :J :K :L]
       [:trans :trans :trans :trans :trans :trans]
       [:trans :trans :trans]]
      :right-override
      [nil
       [:H :J :K :L :* :*]
       nil
       nil]})}]]}
