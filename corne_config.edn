       nil
       [:H [:rh_ht :LEFT_GUI :DE_F] [:rh_ht :LEFT_ALT :DE_C] [:rh_ht :LCTRL :DE_L] [:rh_ht :LEFT_SHIFT :D] :none]
       nil]}
     {:name "Nav1",
      :left
      [[[:tog 5] [:B_UE] :END :PG_UP :PG_DN :HOME]
       [:none [:B_OE] :LEFT_ARROW :DOWN :UP :RIGHT_ARROW]
       [:none
        :DE_A_UMLAUT
        :N9
        [:double_single_quote]
        [:back_front_tick]
