        [:frage_ausrufe_zeichen]
        [:mac_prev_next_window]
        [:swapper]
        [:tmux_next_pre]
        [:kp "LC(DE_U_UMLAUT)"]]
       [:none [:at_equal] [:lCl] [:kCk] [:jCj] [:hCh]]
